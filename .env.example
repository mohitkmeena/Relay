# cdcx environment configuration.
# Copy to .env, adjust, and export before running (or use direnv).

# Local Docker Postgres defaults; point at a real server in production.
CDCX_PG_HOST=localhost
CDCX_PG_PORT=5432
CDCX_PG_USER=postgres
CDCX_PG_PASSWORD=postgres
CDCX_PG_DATABASE=postgres
CDCX_PG_SLOT=cdcx_slot
CDCX_PG_PUBLICATION=cdcx_pub

# Log verbosity: error, warn, info, debug, trace
RUST_LOG=info
